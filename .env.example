# Frontend (Vite) and docker-compose. Copy to .env.
VITE_API_URL=                # empty = same origin (nginx serves the SPA and proxies /api)
VITE_GOOGLE_CLIENT_ID=       # enables "Sign in with Google"
VITE_APPLE_SIGNIN=           # set to 1 to show "Sign in with Apple"

SEARXNG_SECRET_KEY=          # long random string for the bundled SearXNG

# Local development: where `npm run dev` sends /api and /auth
DEIZA_DEV_BACKEND=http://127.0.0.1:5000
