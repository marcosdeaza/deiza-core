# Deiza Core — backend configuration
# Copy to backend/.env and fill in. Nothing here is committed with real values.
# Every model, URL and key is a variable: point Deiza at your own API, a gateway in
# front of several providers, or a model you serve yourself.

# ── Server ────────────────────────────────────────────────────────────────────
FLASK_SECRET_KEY=            # long random string (python -c "import secrets; print(secrets.token_hex(32))")
FRONTEND_URL=http://localhost:8080   # CORS origin and base for links in emails
DATABASE_URL=sqlite:///deiza.db       # any SQLAlchemy URL works
ADMIN_SECRET=                # protects /api/admin/* (header X-Admin-Secret)

# ── Workspace models (chat, documents, images, video, speech) ─────────────────
# MODEL_API_URL is a template: {model} and {action} are filled per request.
# The actions are generateContent and streamGenerateContent (plus predictLongRunning /
# fetchPredictOperation for video). Any endpoint or gateway that speaks them works.
MODEL_API_URL=https://your-endpoint.example/v1/models/{model}:{action}
MODEL_API_KEY=
MODEL_API_AUTH=query         # query (?key=) | bearer | header:X-Api-Key

# One model name per tier. Empty tiers fall back as noted.
MODEL_VAINILLA=              # light conversational model (served from CODE_API_URL, see below)
MODEL_GAS=                   # fastest
MODEL_FAST=                  # defaults to MODEL_GAS
MODEL_LIQUID=                # default everyday model (Liquid 5)
MODEL_PRO=                   # defaults to MODEL_LIQUID
MODEL_LIQUID45=              # "more models" variant, defaults to MODEL_LIQUID
MODEL_SOLID=                 # deep reasoning (Solid 4.6)
MODEL_ULTRA=                 # defaults to MODEL_SOLID
MODEL_LITE=                  # tiny helper calls (intent checks, plans), defaults to MODEL_GAS
# Same-class fallbacks tried on 429/5xx or a stalled stream, as JSON:
# MODEL_FALLBACKS={"liquid-model": ["older-liquid-model"], "solid-model": ["liquid-model"]}
MODEL_FALLBACKS=

# Media. IMAGE_API_URL / VIDEO_API_URL override MODEL_API_URL for these models.
IMAGE_MODEL=
IMAGE_FALLBACK_MODEL=
IMAGE_API_URL=
VIDEO_MODEL=
VIDEO_FAST_MODEL=
VIDEO_API_URL=

# Speech: dictation and read-aloud.
STT_MODEL=
STT_FALLBACK_MODEL=
TTS_MODEL=
TTS_VOICES=                  # comma-separated voice names the client may choose
TTS_DEFAULT_VOICE=

# ── Deiza Code and Vainilla (OpenAI-compatible chat/completions) ──────────────
CODE_API_URL=https://your-endpoint.example/v1/chat/completions
CODE_API_KEY=
CODE_MODEL_LIQUID=           # Deiza Omniscient / Liquid 5
CODE_MODEL_SOLID=            # Solid 4.6
CODE_MODEL_GAS=              # Gas 4.5
CODE_MODEL_VAINILLA=         # Vainilla (also used by the chat)
CODE_MODEL_DEFAULT=          # defaults to CODE_MODEL_LIQUID

# ── Search ────────────────────────────────────────────────────────────────────
# SearXNG runs in docker-compose; its secret comes from the root .env (SEARXNG_SECRET_KEY).
SEARCH_GROUNDING_REDIRECT_HOST=   # host of opaque redirect links in grounded answers, if your endpoint returns them

# ── Sign-in ───────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=            # "Sign in with Google" (same value as VITE_GOOGLE_CLIENT_ID)
APPLE_CLIENT_IDS=org.deiza.app   # comma-separated audiences for Sign in with Apple
RESEND_API_KEY=              # magic-link emails via Resend…
RESEND_FROM=noreply@your-domain.example
SMTP_HOST=                   # …or via SMTP
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
BYPASS_EMAILS=               # comma-separated emails that skip the magic link (testing only)

# ── Payments (optional) ───────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_FRIEND=
STRIPE_PRICE_SIGNET=
PLAN_DURATION_DAYS=30

# ── Documents engine ──────────────────────────────────────────────────────────
DOC_RENDER_API_BASE=http://127.0.0.1:5000
DEIZA_MAPPER_CONCURRENCY=
DEIZA_MAPPER_CHROMIUM_ARGS=
